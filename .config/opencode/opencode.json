{
	"$schema": "https://opencode.ai/config.json",
	"agents": {
		"build": {
			"model": "SSC-US/zai-org/GLM-5.3-Flash",
			"permissions": [
				{
					"action": "edit",
					"effect": "ask",
					"resource": "*"
				}
			]
		},
		"explore": {
			"model": "SSC-US/us.anthropic.claude-haiku-5-5"
		},
