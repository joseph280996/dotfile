{
	"$schema": "https://opencode.ai/config.json",
	"agents": {
		"build": {
			"model": "SSC-US/zai-org/GLM-5.3-Flash",
			"permissions": [
				{
					"action": "edit",
					"effect": "ask",
					"resource": "*"
				}
			]
		},
		"explore": {
			"model": "SSC-US/us.anthropic.claude-haiku-5-5"
		},
		"title": {
			"model": "SSC-US/us.anthropic.claude-haiku-5-5"
		}
	},
	"mcp": {
		"servers": {
			"ag-mcp": {
				"command": ["npx", "ag-mcp"],
				"type": "local"
			},
			"grafana": {
				"command": ["uvx", "mcp-grafana"],
				"environment": {
					"GRAFANA_URL": "{env:GRAFANA_URL}",
					"GRAFANA_PASSWORD": "{env:GRAFANA_PASSWORD}",
					"GRAFANA_USERNAME": "{env:GRAFANA_USERNAME}"
				},
				"type": "local"
			},
			"grafana-metrics-dev": {
				"command": ["/Users/tpham4/.config/opencode/bin/mcp-grafana-cookie-login"],
				"environment": {
					"GRAFANA_METRICS_DEV_PASSWORD": "{env:GRAFANA_METRICS_DEV_PASSWORD}",
					"GRAFANA_METRICS_DEV_USERNAME": "{env:GRAFANA_METRICS_DEV_USERNAME}"
				},
				"type": "local"
			},
			"jenkins": {
				"command": ["npx", "jenkins-mcp", "--jenkins-url", "{env:JENKINS_URL}", "--jenkins-username", "tpham4", "--jenkins-password", "{env:JENKINS_API_KEY}"],
				"type": "local"
			},
			"lean-ctx": {
				"command": ["/opt/homebrew/bin/lean-ctx"],
				"disabled": false,
				"environment": {
					"LEAN_CTX_DATA_DIR": "/Users/tpham4/.config/lean-ctx"
				},
				"type": "local"
			},
			"mcp-atlassian": {
				"command": ["uvx", "mcp-atlassian"],
				"environment": {
					"JIRA_API_TOKEN": "{env:ATLASSIAN_JIRA_API_KEY}",
					"JIRA_URL": "{env:ATLASSIAN_JIRA_URL}",
					"JIRA_USERNAME": "tung.pham@sscinc.com"
				},
				"type": "local"
			},
			"memory": {
				"command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
				"type": "local"
			},
			"playwright": {
				"command": ["npx", "@playwright/mcp@latest"],
				"type": "local"
			},
			"sequentialthinking": {
				"command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
				"type": "local"
			},

			"sonarqube": {
				"type": "local",
				"command": [
					"docker",
					"run",
					"--init",
					"--pull=always",
					"-i",
					"--rm",
					"-e",
					"SONARQUBE_TOKEN",
					"-e",
					"SONARQUBE_URL",
					"-e",
					"SONARQUBE_IDE_PORT",
					"sonarsource/sonarqube-mcp"
				],
				"environment": {
					"SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
					"SONARQUBE_URL": "{env:SONARQUBE_URL}",
					"SONARQUBE_IDE_PORT": "{env:SONARQUBE_IDE_PORT}"
				}
			}
		}
	},
	"model": "SSC-US/us.anthropic.claude-sonnet-5",
	"permissions": "{file:./permission.json}",
	"plugins": ["superpowers@git+https://github.com/obra/superpowers.git", "@plannotator/opencode@latest"],
	"providers": {
		"SSC-US": {
			"name": "SSNC US Gateway",
			"package": "aisdk:@ai-sdk/anthropic",
			"settings": {
				"baseURL": "https://api-ai-us.ssnc-corp.cloud/claude"
			}
			"models": {
				"google/gemma-4-31B-it": {
					"limit": {
						"context": 32000,
						"output": 32000
					},
					"name": "Gemma 4 (31B)"
				},
				"us.anthropic.claude-haiku-5-5": {
					"name": "Haiku 5.5"
				},
				"us.anthropic.claude-haiku-5-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "us.anthropic.claude-haiku-5-5",
					"name": "Haiku 5.5 (1M)"
				},
				"us.anthropic.claude-opus-5-5": {
					"name": "Opus 5.5",
					"settings": {
						"thinking": {
							"display": "summarized",
							"type": "adaptive"
						}
					}
				},
				"us.anthropic.claude-opus-5-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "us.anthropic.claude-opus-5-5",
					"name": "Opus 5.5 (1M)",
					"settings": {
						"thinking": {
							"display": "summarized",
							"type": "adaptive"
						}
					}
				},
				"us.anthropic.claude-sonnet-5": {
					"name": "Sonnet 5"
				},
				"us.anthropic.claude-sonnet-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "us.anthropic.claude-sonnet-5",
					"name": "Sonnet 5 (1M)"
				},
				"us.anthropic.claude-sonnet-5-5": {
					"name": "Sonnet 5.5"
				},
				"us.anthropic.claude-sonnet-5-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "us.anthropic.claude-sonnet-5-5",
					"name": "Sonnet 5.5 (1M)"
				},
				"zai-org/GLM-5.3-Flash": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"name": "GLM-5.3 Flash"
				},
				"zai-org/GLM-5.3": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"name": "GLM-5.3"
				}
			},
		},
		"SSC-UK": {
			"name": "SSNC UK Gateway",
			"package": "aisdk:@ai-sdk/anthropic",
			"settings": {
				"baseURL": "https://api-ai-uk.ssnc-corp.cloud/claude"
			}
			"models": {
				"google/gemma-4-31B-it": {
					"limit": {
						"context": 32000,
						"output": 32000
					},
					"name": "Gemma 4 (31B)"
				},
				"uk.anthropic.claude-haiku-5-5": {
					"name": "Haiku 5.5"
				},
				"uk.anthropic.claude-haiku-5-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "uk.anthropic.claude-haiku-5-5",
					"name": "Haiku 5.5 (1M)"
				},
				"uk.anthropic.claude-opus-5-5": {
					"name": "Opus 5.5",
					"settings": {
						"thinking": {
							"display": "summarized",
							"type": "adaptive"
						}
					}
				},
				"uk.anthropic.claude-opus-5-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "uk.anthropic.claude-opus-5-5",
					"name": "Opus 5.5 (1M)",
					"settings": {
						"thinking": {
							"display": "summarized",
							"type": "adaptive"
						}
					}
				},
				"uk.anthropic.claude-sonnet-5": {
					"name": "Sonnet 5"
				},
				"uk.anthropic.claude-sonnet-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "uk.anthropic.claude-sonnet-5",
					"name": "Sonnet 5 (1M)"
				},
				"uk.anthropic.claude-sonnet-5-5": {
					"name": "Sonnet 5.5"
				},
				"uk.anthropic.claude-sonnet-5-5-1m": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"modelID": "uk.anthropic.claude-sonnet-5-5",
					"name": "Sonnet 5.5 (1M)"
				},
				"zai-org/GLM-5.3-Flash": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"name": "GLM-5.3 Flash"
				},
				"zai-org/GLM-5.3": {
					"limit": {
						"context": 1000000,
						"output": 64000
					},
					"name": "GLM-5.3"
				}
			},
		}
	},
	"references": {
		"global-skills": {
			"description": "This is where all of the global agent skills live. Use it for when user request a new skill or a modification to an existing skill.",
			"path": "~/.config/opencode/skills"
		},
		"hercules": {
			"description": "The main service that drives everything in Eclipse Trading. This is where all the workflows live and holds all the code of those workflow.",
			"path": "~/Code/Work/IMST-hercules"
		},
		"knowledge-base": {
			"description": "Use for general knowledge on how each service and the works that was done. Use this folder for writing plans that are not tied to a Jira ticket; Jira-scoped plans, specs and notes go to ~/notes/TRAD/Jiras (see rules/jira-notes.md).",
			"path": "~/Documents/knowledge-base"
		},
		"nvim-config": {
			"description": "Use for any neovim configuration that needs to be changed while working",
			"path": "~/.config/nvim"
		},
		"opencode-agents": {
			"description": "This is where all of the global agent description live. Use it for when user request a new specialized agent or a modification to an existing one.",
			"path": "~/.config/opencode/agents"
		},
		"opencode-skills": {
			"description": "This is where all of the agent skills live. Use it for when user request a new skill or a modification to an existing skill.",
			"path": "~/.config/opencode/skills"
		},
		"personal-notes": {
			"description": "This holds all notes on past works, future works or current work. This is where I tried to document what I did daily as well as the notes that I have for certain things when working on a JIRA",
			"path": "~/notes"
		},
		"plannotator": {
			"description": "This is where all the plans that was submitted to Plannotator lives. Use this to look at any plans created given the context of what we're currently doing.",
			"path": "~/.plannotator/plans"
		},
		"service-docs": {
			"description": "This holds all the documentation of the current service and gives information for reference on anything related to the current service.",
			"path": "./docs"
		},
		"services-architecture": {
			"description": "This holds all the services' architecture documentation within Eclipse. Consult for any work or design regarding system architecture.",
			"path": "~/Code/Work/ARCH-eclipse-knowledgebase/"
		}
	}
}
