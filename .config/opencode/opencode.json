	"mcp": {
		"servers": {
			"ag-mcp": {
				"command": ["npx", "ag-mcp"],
				"type": "local"
			},
			"grafana": {
				"command": ["uvx", "mcp-grafana"],
				"environment": {
					"GRAFANA_URL": "{env:GRAFANA_URL}",
					"GRAFANA_PASSWORD": "{env:GRAFANA_PASSWORD}",
					"GRAFANA_USERNAME": "{env:GRAFANA_USERNAME}"
				},
				"type": "local"
			},
			"grafana-metrics-dev": {
				"command": ["/Users/tpham4/.config/opencode/bin/mcp-grafana-cookie-login"],
				"environment": {
					"GRAFANA_METRICS_DEV_PASSWORD": "{env:GRAFANA_METRICS_DEV_PASSWORD}",
					"GRAFANA_METRICS_DEV_USERNAME": "{env:GRAFANA_METRICS_DEV_USERNAME}"
				},
				"type": "local"
			},
			"jenkins": {
				"command": ["npx", "jenkins-mcp", "--jenkins-url", "{env:JENKINS_URL}", "--jenkins-username", "tpham4", "--jenkins-password", "{env:JENKINS_API_KEY}"],
				"type": "local"
			},
			"lean-ctx": {
				"command": ["/opt/homebrew/bin/lean-ctx"],
				"disabled": false,
				"environment": {
					"LEAN_CTX_DATA_DIR": "/Users/tpham4/.config/lean-ctx"
				},
				"type": "local"
			},
			"mcp-atlassian": {
				"command": ["uvx", "mcp-atlassian"],
				"environment": {
					"JIRA_API_TOKEN": "{env:ATLASSIAN_JIRA_API_KEY}",
					"JIRA_URL": "{env:ATLASSIAN_JIRA_URL}",
					"JIRA_USERNAME": "tung.pham@sscinc.com"
				},
				"type": "local"
			},
			"memory": {
				"command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
				"type": "local"
			},
			"playwright": {
				"command": ["npx", "@playwright/mcp@latest"],
				"type": "local"
			},
			"sequentialthinking": {
				"command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
				"type": "local"
			},

			"sonarqube": {
				"type": "local",
				"command": [
					"docker",
					"run",
					"--init",
					"--pull=always",
					"-i",
					"--rm",
					"-e",
					"SONARQUBE_TOKEN",
					"-e",
					"SONARQUBE_URL",
					"-e",
					"SONARQUBE_IDE_PORT",
					"sonarsource/sonarqube-mcp"
				],
				"environment": {
					"SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
					"SONARQUBE_URL": "{env:SONARQUBE_URL}",
					"SONARQUBE_IDE_PORT": "{env:SONARQUBE_IDE_PORT}"
				}
			}
		}
	},
