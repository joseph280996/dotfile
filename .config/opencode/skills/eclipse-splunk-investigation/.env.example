# Splunk Configuration
#
# RECOMMENDED APPROACH:
#   Run: python3 scripts/setup.py
#
# This creates the .env file and stores SPLUNK_PASSWORD securely in OS keyring.
#
# This file is loaded automatically by the query scripts.
# Loading priority:
#   SPLUNK_HOST/USERNAME: environment variables > this file
#   SPLUNK_PASSWORD:      environment variables > keyring > this file (fallback)

# Splunk hostname (required)
SPLUNK_HOST=splunk-awsprod.ezesoft.net

# Splunk username (required)
SPLUNK_USERNAME=your-username

# Splunk password (DEPRECATED - use keyring instead)
# Only include this for backwards compatibility.
# STRONGLY RECOMMENDED: Remove this line and use keyring.
# If queries report a missing keyring entry, run:
#   python3 scripts/setup.py
# Or store the password manually with:
#   python3 -c "import keyring; keyring.set_password('eclipse-splunk-investigation', 'SPLUNK_PASSWORD', 'your-password')"
#SPLUNK_PASSWORD=your-password
