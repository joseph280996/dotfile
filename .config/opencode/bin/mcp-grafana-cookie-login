#!/bin/bash
# Login wrapper for the grafana-metrics-dev MCP server. Logs in, grabs the
# grafana_sess cookie, and runs mcp-grafana with it as an extra header.
# metrics-dev (Grafana 5.4.2) has basic auth disabled, so a cookie is the
# only self-serve auth path.
set -euo pipefail

: "${GRAFANA_METRICS_DEV_URL:=https://metrics-dev.ezesoft.net/}"
: "${GRAFANA_METRICS_DEV_USERNAME:?GRAFANA_METRICS_DEV_USERNAME is not set}"
: "${GRAFANA_METRICS_DEV_PASSWORD:?GRAFANA_METRICS_DEV_PASSWORD is not set}"

cookie_jar=$(mktemp)
login_body=$(mktemp)
trap 'rm -f "$cookie_jar" "$login_body"' EXIT

http_status=$(curl -s -o "$login_body" -w '%{http_code}' -c "$cookie_jar" \
  -X POST "${GRAFANA_METRICS_DEV_URL%/}/login" \
  -H 'Content-Type: application/json' \
  --data "$(jq -n \
    --arg user "$GRAFANA_METRICS_DEV_USERNAME" \
    --arg password "$GRAFANA_METRICS_DEV_PASSWORD" \
    '{"user": $user, "password": $password}')")

if [ "$http_status" != "200" ]; then
  echo "mcp-grafana-cookie-login: login to ${GRAFANA_METRICS_DEV_URL} failed (HTTP $http_status): $(head -c 200 "$login_body")" >&2
  exit 1
fi

if ! grep -q '"message":"Logged in"' "$login_body"; then
  echo "mcp-grafana-cookie-login: unexpected login response: $(head -c 200 "$login_body")" >&2
  exit 1
fi

# Cookies from Grafana 5.x are HttpOnly ("#HttpOnly_" prefix shifts the
# columns) and are named grafana_sess, not grafana_session.
session=$(awk '{for (i = 1; i <= NF; i++) if ($i == "grafana_sess") print $(i + 1)}' "$cookie_jar" | head -n 1)

if [ -z "$session" ]; then
  echo "mcp-grafana-cookie-login: login succeeded but no grafana_sess cookie was returned" >&2
  exit 1
fi

# The parent environment may carry GRAFANA_USERNAME/GRAFANA_PASSWORD, which
# mcp-grafana would send as basic auth and metrics-dev would reject with 401.
unset GRAFANA_USERNAME GRAFANA_PASSWORD GRAFANA_API_KEY GRAFANA_SERVICE_ACCOUNT_TOKEN

export GRAFANA_URL="$GRAFANA_METRICS_DEV_URL"
export GRAFANA_EXTRA_HEADERS="$(jq -n --arg session "$session" '{"Cookie": "grafana_sess=\($session)"}')"

exec uvx mcp-grafana
