#!/usr/bin/fish

set -gx EDITOR nvim
set -gx TZ "America/New_York"

set -gx LEAN_CTX_SHELL_ACTIVATION agents-only

# Claude Code
set -gx CLAUDE_CONFIG_DIR "~/.config/claude"
set -gx ANTHROPIC_AUTH_TOKEN ""
set -gx ANTHROPIC_BASE_URL ""


# Postman MCP
set -gx POSTMAN_API_KEY ""

# GitHub MCP
set -gx GITHUB_PAT ""

# Atlassian MCP
set -gx ATLASSIAN_JIRA_API_KEY ""
set -gx ATLASSIAN_JIRA_URL ""
set -gx ATLASSIAN_EMAIL ""

# Jenkins MCP
set -gx JENKINS_URL ""
set -gx JENKINS_API_KEY ""

# Splunk MCP
set -gx SPLUNK_HOST_CATLE ""
set -gx SPLUNK_HOST_PROD ""
set -gx SPLUNK_USERNAME ""
set -gx SPLUNK_PASSWORD ""

# Context7 MCP
set -gx CTX7_API_KEY ""

# SSC stuff
set -gx SSC_AI_GATEWAY_KEY ""

# SonarQube
set -gx SONARQUBE_TOKEN ""
set -gx SONARQUBE_URL ""
set -gx SONARQUBE_IDE_PORT ""

# Grafana
set -gx GRAFANA_URL ""
set -gx GRAFANA_USERNAME ""
set -gx GRAFANA_PASSWORD ""

# Grafana metrics-dev (via mcp-grafana-cookie-login wrapper; basic auth is
# disabled on that instance, the wrapper logs in and uses the session cookie)
set -gx GRAFANA_METRICS_DEV_USERNAME ""
set -gx GRAFANA_METRICS_DEV_PASSWORD ""

# Sentry one
set -gx SENTRYONE_USERNAME ""
set -gx SENTRYONE_DOMAIN ""
set -gx SENTRYONE_PASSWORD ""

